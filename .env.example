OPENAI_API_KEY=sk-proj-...
# Google: SDK は GEMINI_API_KEY を自動参照します。書籍 ch02 では GOOGLE_API_KEY を例示していますが、
# 配布リポジトリでは GEMINI_API_KEY を使用してください。両方記載しておくと混乱がありません。
GEMINI_API_KEY=AI...
GOOGLE_API_KEY=AI...
ANTHROPIC_API_KEY=sk-ant-...

# models:
# gpt-5-mini
# claude-haiku-4-5-20251001
# gemini-2.5-flash

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=$ANTHROPIC_API_KEY